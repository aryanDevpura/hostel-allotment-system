# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Admin portal auth
# Generate hash: node -e "require('bcryptjs').hash('yourpassword',12).then(console.log)"
ADMIN_PASSWORD_HASH="$2b$12$..."

# Random token for admin session cookie
# Generate: node -e "require('crypto').randomBytes(32).toString('hex')"  
ADMIN_SESSION_TOKEN="your-random-64-char-hex-string"

# JWT Secret for student auth (use a strong random string in production)
JWT_SECRET="your-strong-random-jwt-secret-here"
